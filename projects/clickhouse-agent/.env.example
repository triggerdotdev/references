# The project ref from your Trigger.dev dashboard (Project settings, or shown when you create the project)
TRIGGER_PROJECT_REF=proj_xxxxxxxxxxxxxxxxxxxxxxxx

# The demo sets these two in the Trigger.dev dashboard (Environment Variables page),
# so they are intentionally NOT set here. Uncomment to override locally instead:
#
# ClickHouse Cloud HTTPS endpoint with credentials baked in:
# CLICKHOUSE_URL=https://default:YOUR_PASSWORD@YOUR_SERVICE.clickhouse.cloud:8443
#
# ANTHROPIC_API_KEY=sk-ant-...
